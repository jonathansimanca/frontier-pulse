# Configuración de variables de entorno para Frontier Pulse

# Autenticación GCP: Se utiliza Application Default Credentials (ADC) mediante:
# `gcloud auth application-default login`

# Opcional: Clave de Gemini API si se utiliza Google AI Studio en lugar de Vertex AI
GEMINI_API_KEY=tu_gemini_api_key_opcional

# Configuración del Bot de Telegram para entrega automática
TELEGRAM_BOT_TOKEN=tu_bot_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id_o_canal
