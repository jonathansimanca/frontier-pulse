# Environment Variables Configuration for Frontier Pulse
# Copy this file to .env and provide your API keys / settings

# Google Gemini Developer API Key (Required for LLM research, script, and image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-3.7-flash)
GEMINI_DEFAULT_MODEL=gemini-3.7-flash
GEMINI_RESEARCH_MODEL=gemini-3.7-flash

# Google Cloud Project (used for Cloud Storage persistence and Text-to-Speech)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Telegram Bot configuration for automated podcast publishing
# (Set TELEGRAM_ENABLED=false if testing in local environments behind corporate firewalls)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=true
# Google Cloud Text-to-Speech Voice (default: es-US-Chirp-HD-O)
PODCAST_VOICE_NAME=es-US-Chirp-HD-O

# Google Cloud Storage bucket for persistence and history synchronization across Cloud Functions
GCS_BUCKET_NAME=your_gcs_bucket_name_here
