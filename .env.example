# Environment Variables Configuration for Frontier Pulse
# Copy this file to .env and provide your API keys / settings

# GCP & Vertex AI Configuration
# Authenticate your terminal using: `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
USE_VERTEX_AI=true

# Google Gemini API Key (optional fallback if not using Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-2.5-flash on Vertex AI)
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_RESEARCH_MODEL=gemini-2.5-flash

# Telegram Bot configuration for automated podcast publishing
# (Set TELEGRAM_ENABLED=false if testing in local environments behind corporate firewalls)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=true
# Google Cloud Text-to-Speech Voice (default: es-US-Chirp-HD-O)
PODCAST_VOICE_NAME=es-US-Chirp-HD-O

# Google Cloud Storage bucket for persistence and history synchronization across Cloud Functions
GCS_BUCKET_NAME=your_gcs_bucket_name_here
